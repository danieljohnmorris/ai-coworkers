#!/usr/bin/env bash
# Interactive coworker generator. Asks JD-style questions and writes the
# role docs. Usage: bin/new-coworker-interview.sh <name>
_aicw_self="$(basename "$(readlink -f "${BASH_SOURCE[0]}")")"
_aicw_invoked="$(basename "$0")"
if [ "$_aicw_invoked" != "$_aicw_self" ]; then
  echo "[deprecated] bin/$_aicw_invoked is now bin/aicw ${_aicw_self#aicw-} — this symlink will be removed in a future release" >&2
fi
set -euo pipefail
name="${1:?usage: new-coworker-interview <name>}"
root="$(cd "$(dirname "$0")/.." && pwd)"
dst="$root/coworkers/$name"
if [ -e "$dst" ]; then echo "already exists: $dst" >&2; exit 1; fi
mkdir -p "$dst/role" "$dst/state"

ask() { local prompt="$1"; local -n out=$2; read -e -r -p "$prompt" out; }

echo "Interviewing you for a new coworker: $name"
echo
ask "One paragraph — who is this coworker (role, working style)? > " ROLE
ask "One line — what's their primary area of responsibility? > " AOR
ask "Comma-separated list of tools they need (linear,slack,github,memory): " TOOLS
ask "What is off-limits (comma-separated targets)? " OFFLIMITS
ask "Max LLM calls per day (default 500): " CAP
CAP="${CAP:-500}"
ask "Tick interval — quick (60s), normal (5min), slow (30min)? [normal] " TICK
case "${TICK:-normal}" in quick) ms=60000;; slow) ms=1800000;; *) ms=300000;; esac

cat > "$dst/role/ROLE.md" <<EOF
$ROLE
EOF
cat > "$dst/role/RESPONSIBILITIES.md" <<EOF
- $AOR
- Never spam. Most ticks should be no-ops.
EOF
cat > "$dst/role/AUTHORITY.md" <<'EOF'
## Decide alone
- Add your comments/notes; ask questions of reporters.

## Escalate to your manager
- Anything with financial, legal, or security implications.
- Any change to shared infra.
EOF
cat > "$dst/role/BOUNDARIES.md" <<EOF
## Must not touch
$(printf -- '- %s\n' ${OFFLIMITS//,/ })

## Resource limits
- Max concurrent worktrees: 3
- Max worktree age: 24 h
- Max disk usage: 2048 MB
- Kill subprocesses idle > 30 min
- Max LLM calls per day: $CAP
EOF
cat > "$dst/role/RITUALS.md" <<'EOF'
- Every tick: sweep for new signals; act on at most one.
- 09:00 daily: journal entry for yesterday.
- Sunday 03:00: reflect on the past week.

## Tempo

- Actions per hour: aim for 1–2, cap 4.
- Noop ratio (last 100 ticks): ≳ 0.8.
- If nothing has changed since the last action, noop.
EOF
cat > "$dst/role/RELATIONSHIPS.md" <<'EOF'
- Your manager (human): escalation target.
EOF
tools_lines=""
IFS=, read -ra TARR <<< "$TOOLS"
for t in "${TARR[@]}"; do
  t="$(echo "$t" | xargs)"
  [ -n "$t" ] && tools_lines+="- $t"$'\n'
done
printf '%s' "$tools_lines" > "$dst/role/TOOLS.md"
cat > "$dst/role/WORKSPACE.md" <<EOF
Edit me to describe the world $name operates in — teams, priority conventions,
style preferences, and standing labels.
EOF

echo
echo "scaffolded $dst"
echo "TICK_INTERVAL_MS=$ms  # add to .env if you want a non-default tick"
echo "run:  node --experimental-strip-types --no-warnings src/index.ts $name"
