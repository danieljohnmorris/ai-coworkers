#!/usr/bin/env bash
# AIC-53 — cross-coworker search. Query every coworker's events.db in
# one go via FTS5 (which initEpisodic sets up) and print matches
# grouped by coworker + kind.
#
# Usage:
#   bin/search.sh "some query text"                  # all coworkers, last 30 days
#   bin/search.sh "some query" alex-triage           # scoped to one coworker
#   bin/search.sh "some query" "" 7                  # all coworkers, last 7 days
#
# The query uses FTS5 syntax — quote phrases with double quotes, use OR,
# prefix with kind:action, etc. See runtime/episodic.ts for the schema.

_aicw_self="$(basename "$(readlink -f "${BASH_SOURCE[0]}")")"
_aicw_invoked="$(basename "$0")"
if [ "$_aicw_invoked" != "$_aicw_self" ]; then
  echo "[deprecated] bin/$_aicw_invoked is now bin/aicw ${_aicw_self#aicw-} — this symlink will be removed in a future release" >&2
fi
set -euo pipefail
q="${1:?usage: search <query> [coworker] [days]}"
target="${2:-}"
days="${3:-30}"

[[ "$days" =~ ^[0-9]+$ ]] || { echo "days must be integer" >&2; exit 1; }
if [ -n "$target" ]; then
  [[ "$target" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "invalid coworker name" >&2; exit 1; }
fi

root="$(cd "$(dirname "$0")/.." && pwd)"

Q="$q" TARGET="$target" DAYS="$days" ROOT="$root" \
node --experimental-strip-types --no-warnings -e '
  const fs = await import("node:fs");
  const path = await import("node:path");
  const { DatabaseSync } = await import("node:sqlite");
  const Q = process.env.Q;
  const TARGET = process.env.TARGET;
  const DAYS = Number(process.env.DAYS);
  const since = new Date(Date.now() - DAYS * 86400_000).toISOString();

  const coworkersDir = path.join(process.env.ROOT, "coworkers");
  const targets = TARGET
    ? [TARGET]
    : fs.readdirSync(coworkersDir).filter((n) => {
        try { return fs.statSync(path.join(coworkersDir, n)).isDirectory() && !n.startsWith("."); }
        catch { return false; }
      });

  let total = 0;
  for (const name of targets) {
    const db = path.join(coworkersDir, name, "state", "events.db");
    if (!fs.existsSync(db)) continue;
    const conn = new DatabaseSync(db);
    // FTS5 shadow table `events_fts` (see initEpisodic) mirrors payload.
    let rows;
    try {
      rows = conn.prepare(`
        SELECT e.id, e.ts, e.kind, substr(e.payload, 1, 300) AS snippet
        FROM events e JOIN events_fts f ON f.rowid = e.id
        WHERE f.payload MATCH ? AND e.ts >= ?
        ORDER BY e.id DESC LIMIT 50
      `).all(Q, since);
    } catch (err) {
      console.error(`${name}: search error — ${err.message}`);
      continue;
    }
    if (rows.length === 0) continue;
    console.log(`\n=== ${name} (${rows.length} hits) ===`);
    for (const r of rows) {
      console.log(`  [ev:${r.id} ${r.ts.slice(0, 19).replace("T", " ")}] ${r.kind.padEnd(20)} ${r.snippet.replace(/\s+/g, " ")}`);
    }
    total += rows.length;
  }
  if (total === 0) console.log(`no matches for "${Q}" in the last ${DAYS} days`);
  else console.log(`\n${total} total matches across ${targets.length} coworker(s).`);
'
