#!/usr/bin/env bash
# Interactive Gmail (Google Workspace) setup for a coworker. Wraps the
# Hermes google-workspace skill's setup.py, following its documented
# agent-driven workflow. Scopes the resulting token to this coworker
# only via HERMES_HOME=coworkers/<name>/state/hermes-home/.
#
# Usage:  bin/setup-gmail.sh <coworker>
#
# After: coworkers/<name>/state/hermes-home/google_token.json holds an
# OAuth token that gmail.* tools read via the same HERMES_HOME.
#
# Prerequisite (one-time, ever): a Google Cloud project with the Gmail /
# Drive / Docs / Calendar / Sheets APIs enabled and an OAuth 2.0
# credential of type "Desktop app" downloaded as credentials.json.
# See setup.py --help for the URLs; we don't duplicate them here.

_aicw_self="$(basename "$(readlink -f "${BASH_SOURCE[0]}")")"
_aicw_invoked="$(basename "$0")"
if [ "$_aicw_invoked" != "$_aicw_self" ]; then
  echo "[deprecated] bin/$_aicw_invoked is now bin/aicw ${_aicw_self#aicw-} — this symlink will be removed in a future release" >&2
fi
set -euo pipefail
name="${1:?usage: setup-gmail <coworker>}"
[[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "invalid coworker name" >&2; exit 1; }

root="$(cd "$(dirname "$0")/.." && pwd)"
skill="$HOME/.hermes/skills/productivity/google-workspace/scripts"
[ -f "$skill/setup.py" ] || { echo "Hermes google-workspace skill not found at $skill" >&2; echo "Install Hermes first: https://hermes-agent.nousresearch.com" >&2; exit 1; }

# Scope every google_* file to this coworker's own state dir.
export HERMES_HOME="$root/coworkers/$name/state/hermes-home"
mkdir -p "$HERMES_HOME"
echo "Token will land at: $HERMES_HOME/google_token.json"
echo

# 0. Ensure Python deps are installed. Idempotent — no-op when already
#    present. Runs first so setup.py --check below can actually import
#    google.oauth2 etc without a confusing traceback.
echo "Step 0/3 — Verify Python dependencies (idempotent)"
if ! python "$skill/setup.py" --install-deps; then
  echo "✗ Could not install Python deps. Check python3 + pip on PATH." >&2
  exit 1
fi
echo

# 1. Check current state.
if python "$skill/setup.py" --check >/dev/null 2>&1; then
  echo "✓ Already authenticated for coworker '$name'. Nothing to do."
  exit 0
fi

# 2. Client secret.
if [ ! -f "$HERMES_HOME/google_client_secret.json" ]; then
  echo "Step 1/3 — Google Cloud OAuth client secret"
  echo "  Follow: https://console.cloud.google.com/apis/credentials"
  echo "  Create OAuth 2.0 client of type 'Desktop app', download JSON."
  echo
  read -rp "  Path to downloaded credentials.json: " secret_path
  [ -f "$secret_path" ] || { echo "no such file: $secret_path" >&2; exit 1; }
  python "$skill/setup.py" --client-secret "$secret_path"
  echo
fi

# 3. Auth URL + code exchange.
echo "Step 2/3 — Authorize in browser"
url=$(python "$skill/setup.py" --auth-url)
echo "  Visit:"
echo "    $url"
echo "  Sign in with the Google account you want '$name' to act as."
echo "  After 'Continue', you'll be redirected to a page showing an auth code."
echo
read -rp "  Paste the auth code: " code
[ -n "$code" ] || { echo "empty code" >&2; exit 1; }
python "$skill/setup.py" --auth-code "$code"
echo

# 4. Verify.
echo "Step 3/3 — Verify"
if python "$skill/setup.py" --check; then
  echo "✓ Gmail set up for '$name'. Token at $HERMES_HOME/google_token.json."
  echo "  Tools: gmail.search, gmail.get, gmail.send, gmail.reply, calendar.*, drive.*, docs.*, sheets.*"
else
  echo "✗ Setup did not complete cleanly. Re-run to retry." >&2
  exit 1
fi
