node_modules/
*.db
*.db-journal
*.db-wal
*.db-shm
# Real coworker instances are per-machine state. Never commit them —
# they contain personal workspace facts, credentials, and running memory.
# Sanitised templates live under examples/ instead.
coworkers/*
!coworkers/README.md
!coworkers/.gitkeep
.env
.env.local
.env.*
*.pem
*.key
# credentials.json / token.json come from Google OAuth flow — keep them local
credentials.json
token.json
*.log
.DS_Store
dist/

coverage/

# Python bytecode (contrib/ has some .py files)
__pycache__/
*.pyc
