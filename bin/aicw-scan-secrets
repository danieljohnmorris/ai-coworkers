#!/usr/bin/env node
// Scan files (or the whole tree, or git history) for credential-shaped
// substrings. Uses the same pattern library as runtime redaction so we
// have ONE list to keep updated.
//
// Usage:
//   bin/scan-secrets.mjs <file> [<file>...]      # scan specific files
//   bin/scan-secrets.mjs --staged                # scan git-staged files (pre-commit hook mode)
//   bin/scan-secrets.mjs --tree                  # scan every tracked file
//   bin/scan-secrets.mjs --history               # scan every blob in git history
//
// Exit code:
//   0 — no secrets found
//   1 — one or more findings (details printed to stderr)
//   2 — bad usage / internal error

import { basename } from "node:path";
{
  const self = basename(new URL(import.meta.url).pathname);
  const invoked = basename(process.argv[1] || self);
  if (invoked !== self) {
    process.stderr.write(`[deprecated] bin/${invoked} is now bin/aicw ${self.replace(/^aicw-/, "")} — this symlink will be removed in a future release\n`);
  }
}
import { readFileSync, statSync, existsSync } from "node:fs";
import { execSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const here = dirname(fileURLToPath(import.meta.url));
const repoRoot = join(here, "..");

// Re-import the pattern library so we don't drift. The runtime module
// uses TypeScript, so run it through --experimental-strip-types.
async function loadPatterns() {
  const mod = await import(join(repoRoot, "src/runtime/secret_redaction.ts"));
  // Not exported — pull from the module by using redact() which walks
  // them internally. Easier: re-declare here as a mirror. We check
  // parity via a test (see scan-secrets.test.mjs).
  return mod;
}

// Same patterns as src/runtime/secret_redaction.ts SECRET_PATTERNS.
// Kept in sync via test/scan-secrets-parity.test.ts (see below).
const PATTERNS = [
  { name: "pem_private_key",         re: /-----BEGIN [A-Z ]+PRIVATE KEY-----[\s\S]+?-----END [A-Z ]+PRIVATE KEY-----/g },
  { name: "anthropic_key",           re: /\bsk-ant-[A-Za-z0-9_\-]{40,}\b/g },
  { name: "openai_key",              re: /\bsk-(?:proj-)?[A-Za-z0-9]{40,}\b/g },
  { name: "github_pat_finegrained",  re: /\bgithub_pat_[A-Za-z0-9_]{22,}\b/g },
  { name: "github_pat_classic",      re: /\bghp_[A-Za-z0-9]{36}\b/g },
  { name: "slack_bot_token",         re: /\bxoxb-\d+-\d+-\d+-[a-f0-9]+\b/gi },
  { name: "slack_user_token",        re: /\bxoxp-\d+-\d+-\d+-[a-f0-9]+\b/gi },
  { name: "slack_app_token",         re: /\bxapp-\d+-\d+-\d+-[a-f0-9]+\b/gi },
  { name: "linear_api_key",          re: /\blin_api_[A-Za-z0-9]{20,}\b/g },
  { name: "aws_access_key",          re: /\bAKIA[A-Z0-9]{16}\b/g },
  { name: "google_api_key",          re: /\bAIza[A-Za-z0-9_\-]{35}\b/g },
  { name: "bearer_token",            re: /\b(Bearer|Basic)\s+[A-Za-z0-9._\-+/=]{16,}/gi },
];

// Files we scan even if binary. Everything else with binary detection.
const TEXT_EXT = /\.(md|txt|ts|tsx|js|jsx|mjs|cjs|json|yml|yaml|toml|sh|env|py|rs|go|java|kt|scala|rb|php|html|css|scss|conf|ini|xml)$/i;

// Paths we ALWAYS skip — false positive noise / by-definition contain
// pattern-looking things.
const SKIP = [
  /(^|\/)\.git\//,
  /(^|\/)node_modules\//,
  /(^|\/)coverage\//,
  /(^|\/)dist\//,
  /(^|\/)bin\/scan-secrets\.mjs$/,               // our own file
  /(^|\/)src\/runtime\/secret_redaction\.ts$/,   // pattern library
  /(^|\/)src\/runtime\/secret_redaction\.test\.ts$/,
  /(^|\/)llms-full\.txt$/,                        // may re-include docs that mention patterns
];

function shouldSkip(path) {
  return SKIP.some((re) => re.test(path));
}

function scanContent(content, path) {
  const findings = [];
  for (const { name, re } of PATTERNS) {
    for (const m of content.matchAll(re)) {
      // Best-effort line number for reporting.
      const before = content.slice(0, m.index ?? 0);
      const line = before.split("\n").length;
      findings.push({ path, line, pattern: name, snippet: (m[0] ?? "").slice(0, 40) });
    }
  }
  return findings;
}

function scanFile(path) {
  if (shouldSkip(path)) return [];
  try {
    const s = statSync(path);
    if (!s.isFile()) return [];
    if (s.size > 5 * 1024 * 1024) return [];      // skip files > 5MB
    // Only scan text-ish files; heuristic: known text ext OR try utf8 decode
    // and skip if it contains many null bytes.
    if (!TEXT_EXT.test(path)) {
      const buf = readFileSync(path);
      let nulls = 0;
      for (let i = 0; i < Math.min(buf.length, 4096); i++) if (buf[i] === 0) nulls++;
      if (nulls > 5) return [];
    }
    return scanContent(readFileSync(path, "utf8"), path);
  } catch {
    return [];
  }
}

function gitLines(cmd) {
  try { return execSync(cmd, { cwd: repoRoot }).toString().split("\n").filter(Boolean); }
  catch { return []; }
}

function scanStaged() {
  const files = gitLines("git diff --cached --name-only --diff-filter=ACM");
  return files.flatMap((f) => scanFile(join(repoRoot, f)));
}

function scanTree() {
  const files = gitLines("git ls-files");
  return files.flatMap((f) => scanFile(join(repoRoot, f)));
}

function scanHistory() {
  // Every blob that has ever been in the repo. Heavier — a few seconds
  // on medium repos, tens on large ones. `git rev-list --all --objects`
  // gives us "<sha> <path>" pairs — we honour the SKIP list against the
  // path so test fixtures and the pattern library itself don't false-
  // positive here just because history mode can't see their filenames.
  const lines = gitLines("git rev-list --all --objects");
  const shaToPaths = new Map();               // sha → Set(paths)
  for (const l of lines) {
    const sp = l.indexOf(" ");
    const sha = sp === -1 ? l : l.slice(0, sp);
    const path = sp === -1 ? "" : l.slice(sp + 1);
    if (!shaToPaths.has(sha)) shaToPaths.set(sha, new Set());
    if (path) shaToPaths.get(sha).add(path);
  }
  const findings = [];
  for (const [sha, paths] of shaToPaths) {
    // If EVERY path this blob was seen at is in the SKIP list, skip it.
    // A blob that ever existed under a non-skipped path still gets scanned.
    if (paths.size > 0 && [...paths].every((p) => shouldSkip(p))) continue;
    try {
      const type = execSync(`git cat-file -t ${sha}`, { cwd: repoRoot }).toString().trim();
      if (type !== "blob") continue;
      const size = Number(execSync(`git cat-file -s ${sha}`, { cwd: repoRoot }).toString().trim());
      if (size > 5 * 1024 * 1024) continue;
      const content = execSync(`git cat-file -p ${sha}`, { cwd: repoRoot, maxBuffer: 20 * 1024 * 1024 }).toString();
      // Report using the first known path for the blob so operators can
      // find it, falling back to the sha if it was never referenced.
      const label = paths.size ? [...paths][0] : `blob:${sha.slice(0, 10)}`;
      findings.push(...scanContent(content, `${label} (blob:${sha.slice(0, 10)})`));
    } catch { /* skip unreadable */ }
  }
  return findings;
}

const argv = process.argv.slice(2);
if (argv.length === 0) {
  process.stderr.write("usage: bin/scan-secrets.mjs <file>... | --staged | --tree | --history\n");
  process.exit(2);
}

let findings = [];
if (argv[0] === "--staged")       findings = scanStaged();
else if (argv[0] === "--tree")    findings = scanTree();
else if (argv[0] === "--history") findings = scanHistory();
else                              findings = argv.flatMap((p) => scanFile(p));

if (findings.length === 0) {
  process.stderr.write(`ok — no secrets found (${argv.join(" ")})\n`);
  process.exit(0);
}

process.stderr.write(`\nFOUND ${findings.length} secret-shaped substring(s):\n\n`);
for (const f of findings) {
  process.stderr.write(`  ${f.path}:${f.line}  [${f.pattern}]  ${f.snippet}...\n`);
}
process.stderr.write("\nIf any of these are REAL secrets:\n");
process.stderr.write("  1. Do NOT commit. Move the value to a coworker/<name>/.env (gitignored).\n");
process.stderr.write("  2. If already committed, ROTATE the key at its source (Linear, Slack, etc.).\n");
process.stderr.write("  3. Consider git-filter-repo to purge from history: https://github.com/newren/git-filter-repo\n\n");
process.stderr.write("If a finding is a FALSE POSITIVE, add the path to the SKIP list in bin/scan-secrets.mjs.\n");
process.exit(1);
